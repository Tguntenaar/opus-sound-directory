{
  "name": "opus-sound-directory",
  "main": ".cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS"
  }
  // After R2 is enabled, add:
  // "r2_buckets": [{ "binding": "AUDIO_R2", "bucket_name": "opus-sounds-audio" }]
}
